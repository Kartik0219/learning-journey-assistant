# Copy this file to .env and fill in real values.
# NEVER commit a real .env file - it is already covered by .gitignore.
# See requirement N3: "Do not keep passwords or API keys in the source code."

# --- Database (N7: shared database) ---
# Local dev default (SQLite file, created automatically):
DATABASE_URL=sqlite:///./ljas_dev.db
# Example for Supabase/Postgres in production:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# --- Moodle Web Services (F1) ---
# Read-only token issued by the subject's Moodle admin / La Trobe IT.
# Leave blank during development - the loader falls back to the historical
# dataset automatically (N9) when this is unset.
MOODLE_BASE_URL=
MOODLE_WS_TOKEN=

# --- Real historical dataset (IOG-33, N9) ---
# Absolute or relative path to the real provided .xlsx workbook, e.g.
# data/provided/CSE_results_150_students_3_Subjects.xlsx. That folder is
# gitignored - real student records must never be committed. Leave blank
# to use the synthetic data/sample/ CSVs (zero setup, what pytest uses).
HISTORICAL_DATASET_PATH=

# --- AI / LLM provider (F3, F7, F8) ---
# Whichever provider the team settles on (OpenAI, Anthropic, etc.) - trial /
# free-tier credits per the tender's Price and Budget section. Abstracted
# behind src/model so the provider can be swapped (tender risk mitigation).
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override for the opt-in LLM analysis path
# (src/model/ai_analysis.py). Two providers are implemented - "anthropic"
# and "gemini". Leave LLM_PROVIDER blank to keep the local, explainable
# TF-IDF engine as the default (what pytest and a fresh clone use).
#
# Option A - Gemini (no cost; Google AI Studio free tier, no extra package
# to install because it goes over REST with `requests`):
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=AIza...            (from https://aistudio.google.com/apikey)
#   LLM_MODEL=gemini-flash-latest  (optional; this is the default)
#
# Option B - Claude (needs `pip install anthropic` and API credit):
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#   LLM_MODEL=claude-sonnet-4-5    (optional)
LLM_MODEL=

# --- App ---
# Set to a long random string in production; used nowhere yet in Phase 1,
# reserved for session/auth work in Phase 5 (N1, N3).
APP_SECRET_KEY=changeme-dev-only

# --- Encryption at rest (N3, IOG-42) ---
# Encrypts Student.student_number / display_name. The default below is a
# real, valid Fernet key but it's PUBLIC (it's in this example file and in
# src/config.py's fallback) - fine for local dev only. Generate your own
# for anything beyond that with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key without re-encrypting existing rows makes them
# permanently unreadable - see src/security/encryption.py.
ENCRYPTION_KEY=XOcjJUrnSvGw5MrTuZKQ0hxBhnlPk5yjxyQuKnyxFJY=

LOG_LEVEL=INFO
